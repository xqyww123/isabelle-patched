#!/usr/bin/env bash
#
# Author: Makarius
#
# Main Isabelle application script.

# minimal Isabelle environment

ISABELLE_HOME="$(cd "$(dirname "$0")"; cd "$(pwd -P)/../.."; pwd)"
source "$ISABELLE_HOME/lib/scripts/isabelle-platform"

#paranoia settings -- avoid intrusion of alien options
unset "_JAVA_OPTIONS"
unset "JAVA_TOOL_OPTIONS"

#paranoia settings -- avoid problems of Java/Swing versus XIM/IBus etc.
unset XMODIFIERS

COMPONENT="$ISABELLE_HOME/contrib/jdk-25.0.4"
source "$COMPONENT/etc/settings"


# main

declare -a JAVA_OPTIONS=($(grep -v '^#' "$ISABELLE_HOME/Isabelle.options"))

eval $("$ISABELLE_JDK_HOME/bin/java" "${JAVA_OPTIONS[@]}" -classpath "$ISABELLE_HOME/contrib/flatlaf-3.7.2/lib/flatlaf-3.7.2-no-natives.jar:$ISABELLE_HOME/contrib/flatlaf-3.7.2/lib/flatlaf-extras-3.7.2.jar:$ISABELLE_HOME/contrib/isabelle_setup-20261009/lib/isabelle_setup.jar:$ISABELLE_HOME/contrib/itext-2.1.5/lib/iText-2.1.5.jar:$ISABELLE_HOME/contrib/javamail-20251022/lib/jakarta.mail-api-2.1.5.jar:$ISABELLE_HOME/contrib/javamail-20251022/lib/jakarta.activation-api-2.1.4.jar:$ISABELLE_HOME/contrib/javamail-20251022/lib/angus-mail-2.0.5.jar:$ISABELLE_HOME/contrib/javamail-20251022/lib/angus-activation-2.0.3.jar:$ISABELLE_HOME/contrib/jedit-20260515/jedit5.7.0-patched/jedit.jar:$ISABELLE_HOME/contrib/jfreechart-1.5.6-1/lib/jfreechart-1.5.6.jar:$ISABELLE_HOME/contrib/jortho-1.0-2/jortho.jar:$ISABELLE_HOME/contrib/jsoup-1.21.2/lib/jsoup-1.21.2.jar:$ISABELLE_HOME/contrib/jsvg-2.0.0/lib/jsvg-2.0.0.jar:$ISABELLE_HOME/contrib/kodkodi-20260628/jar/antlr-runtime-3.1.1.jar:$ISABELLE_HOME/contrib/kodkodi-20260628/jar/kodkod-1.5.jar:$ISABELLE_HOME/contrib/kodkodi-20260628/jar/kodkodi-1.5.7.jar:$ISABELLE_HOME/contrib/kodkodi-20260628/jar/sat4j-2.3.jar:$ISABELLE_HOME/contrib/postgresql-42.7.12/lib/postgresql-42.7.12.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala-library-2.13.18.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala3-library_3-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala-asm-9.9.0-scala-1.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/compiler-interface-1.10.7.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala3-interfaces-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala3-compiler_3-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/tasty-core_3-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala3-staging_3-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/scala3-tasty-inspector_3-3.3.8.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/jline-reader-3.29.0.jar:$ISABELLE_HOME/contrib/scala-3.3.8-1/lib/jline-terminal-3.29.0.jar:$ISABELLE_HOME/contri